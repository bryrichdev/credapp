# Copy to terraform.tfvars (git-ignored) and fill in.

# The Mac's backup public key: cat ~/credcloud/backup-key.pub
backup_recipient = "age1..."

# Optional:
# region                      = "us-east-1"
# instance_type               = "t4g.small"
# timezone                    = "America/New_York"
# backup_ping_url             = "https://hc-ping.com/..."
# create_github_oidc_provider = false   # if the account already has GitHub's OIDC provider
